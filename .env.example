# Copy to .env and fill in. .env is gitignored — never commit real values.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server-side only — NEVER prefix with VITE_, never bundle into the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Direct Postgres (migration scripts only)
SUPABASE_DB_HOST=db.YOUR-PROJECT-REF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR-DATABASE-PASSWORD
SUPABASE_DB_NAME=postgres
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# Owner app-login credential (scripts/create-owner.mjs, rotate-owner-password.mjs)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=CHANGE-ME
